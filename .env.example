# Copy to .env on the VPS and replace every value before starting the stack.
# Use URL-safe values (letters, numbers, - and _) for POSTGRES_PASSWORD,
# because it is included in the internal database connection URL.
POSTGRES_USER=battle
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password
POSTGRES_DB=battle

BATTLE_ADMIN_USERNAME=admin
BATTLE_ADMIN_PASSWORD=replace_with_a_long_admin_password
BATTLE_SECRET_KEY=replace_with_a_random_64_character_secret

# Public address served by Traefik. The live setup wizard uses it to build the
# exact OBS Browser Source URL; it never derives this URL from a request host.
BATTLE_PUBLIC_URL=https://arena.navit.com.br
BATTLE_TIKTOK_RECONNECT_SECONDS=10
BATTLE_TIKTOK_RECONNECT_MAX_SECONDS=60

# Opcional -- só para o gerador de sprites (Admin -> Gerar sprites).
# Chave da OpenAI (platform.openai.com). Deixe vazio para manter desligado;
# nada mais no sistema depende dela.
BATTLE_IMAGE_API_KEY=
BATTLE_IMAGE_MODEL=gpt-image-1

# Leave empty to use the nginx same-origin proxy included in this project.
VITE_API_URL=

# The fallback port is bound only to localhost. Traefik receives public HTTP/S
# traffic through its Docker network and routes it to the frontend container.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Same-origin requests do not need CORS. Keep this public HTTPS origin in case
# the API is ever called directly by another page.
BATTLE_CORS_ORIGINS=["https://arena.navit.com.br"]

# Values used by the Traefik production overlays. They must match the names
# already configured in the VPS Traefik stack.
BATTLE_DOMAIN=arena.navit.com.br
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Hostinger Docker Manager's Traefik on this VPS uses the HTTP challenge.
TRAEFIK_CERT_RESOLVER=letsencrypt
