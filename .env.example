# Copy to .env on the VPS and replace every value before starting the stack.
# Use URL-safe values (letters, numbers, - and _) for POSTGRES_PASSWORD,
# because it is included in the internal database connection URL.
POSTGRES_USER=battle
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password
POSTGRES_DB=battle

BATTLE_ADMIN_USERNAME=admin
BATTLE_ADMIN_PASSWORD=replace_with_a_long_admin_password
BATTLE_SECRET_KEY=replace_with_a_random_64_character_secret

# Opcional -- só para o gerador de sprites (Admin -> Gerar sprites).
# Chave da OpenAI (platform.openai.com). Deixe vazio para manter desligado;
# nada mais no sistema depende dela.
BATTLE_IMAGE_API_KEY=
BATTLE_IMAGE_MODEL=gpt-image-1

# Leave empty to use the nginx same-origin proxy included in this project.
VITE_API_URL=

# Public port exposed by the frontend. The container itself still listens on 80.
HTTP_PORT=8080

# Same-origin requests do not need CORS. Add your public HTTPS origin only if
# another website will call this API directly, e.g. ["https://arena.example.com"].
BATTLE_CORS_ORIGINS=["http://localhost","http://127.0.0.1"]
